# IB Nexus — Environment Variables
# Copy this file to .env.local and fill in your values.

# Supabase (Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Google Gemini AI Integration (Server-side only — DO NOT expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Together AI API key. Leave empty during local UI development.
# Add the real key after purchasing credits.
TOGETHER_API_KEY=
TOGETHER_MOCK_MODE=true

